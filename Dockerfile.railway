# Dockerfile.railway — Render/Railway free-tier deployment
# Uses SQLite (no external DB), seeds demo events on first boot.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/      ./app/
COPY pipeline/ ./pipeline/
COPY data/     ./data/
COPY scripts/  ./scripts/

RUN chmod +x scripts/startup.sh

# Force SQLite — no external DB needed
ENV DATABASE_URL="sqlite+aiosqlite:///./demo.db"
ENV DB_NULL_POOL="false"

EXPOSE 8000

CMD ["bash", "scripts/startup.sh"]
